  "notes": {
    "title": "ZOS 调度与草稿 KV 页式化",
    "intent": "把「调度与计算重叠」（ZOS）落到本引擎，并把草稿 KV 从按行预留改为页池，为长上下文与多卡扩展留接口。",
    "nodes": [
      {
        "id": "compute.model-runner",
        "label": "ModelRunner 主前向循环",
        "summary": "decode/verify 的实际执行者；现同时承载普通 decode、DSpark 投机、ZOS 设备侧推进三条路径。",
        "change": "新增 _run_decode(device_advance=...) / run_decode_advance：ZOS 下不再重建输入，改由 advance_decode 在常驻缓冲上推进；采样回读改成双缓冲 + FIFO 提交/消费分离；_run_verify 去掉单序列假设（按 cu_seqlens 拼平、逐序列落账）；新增 _verify_zos（设备侧元数据 + 整批裁决）。",
        "pitfalls": [
          "回落时不能重新 schedule()：控制器已排过一次，再排会把刚落地的 prefill 当 decode 行（实测 AssertionError len(token_ids)=30 vs 1）",
          "ahead 批里必须放真实 Sequence（ScheduledBatch 装的是 Sequence，不是 SeqSchedule），否则 to_wire 断言失败且 _can_lookahead 的身份比较永远为真 → ZOS 永不生效",
          "spec 一拍产出 1+j 个 token（d_ids 扁平），结束判断要按每行全部产出，用 num_completion+1 会漏 fence",
          "长上下文下草稿 _zos_ub 只增不减，会一路退回 eager（每 32 拍 drain 重锚）",
          "页式草稿下 device_segs 被 fail loud 拒绝：读路径一仍需要 host 侧 seg_max"
        ]
      },
      {
        "id": "compute.batch",
        "label": "Batch 输入缓冲",
        "summary": "常驻的 decode/prefill 输入缓冲与 H2D 打包。",
        "change": "新增 bind_verify(bs, m)：只写常量 cu_seqlens_q、不重绑视图、不做 H2D —— verify 的元数据在 ZOS 下由设备侧 advance_verify 写。",
        "pitfalls": [
          "这里是常驻缓冲，没有 _input_views/_inputs（那是另一个项目的设计）；抄错会 AttributeError"
        ]
      },
      {
        "id": "compute.worker",
        "label": "Worker 执行封装",
        "summary": "单卡内的执行入口，向上提供 run/read_samples。",
        "change": "新增 execute_model_advance / last_decode_dev / last_accept / sync_samples / discard_pending，用于 ZOS 的提前提交与在途结果回收。",
        "pitfalls": [
          "discard_pending 必须与 sync_samples 成对调用，否则过期回读条目会被下一次 read_samples 弹出"
        ]
      },
      {
        "id": "bench-docs-runner",
        "label": "bench 文档与运行脚本",
        "change": "新增 zos_bench（开/关对照，报 decode 步时分位数 + 逐 token 一致 + 流水线计数）；spec_bench 增加 --max-num-seqs / --spec-draft-batch / --spec-draft-paged 等开关。",
        "summary": "性能与一致性的统一入口。"
      }
    ],
    "new_nodes": [
      {
        "path": "src/control/async_decode.py",
        "label": "ZOS 控制器",
        "summary": "把下一拍提交提前到上一拍结果处理之前：submit（只发射 + 异步 D2H）/ consume（唯一同步点）/ plan_lookahead（四个 drain + 两个 fence）。",
        "pitfalls": [
          "只处理纯 greedy decode 批；prefill、批次变化、行序变化一律 drain 回同步路径",
          "EOS 与 radix 换页必须 fence（先等在途那拍），否则 update 释放的页会被在途计算写入"
        ]
      },
      {
        "path": "src/compute/decode_inputs.py",
        "label": "设备侧输入推进",
        "summary": "advance_decode（每行推进 1 或 1+j，写 input_ids/positions/slot_mapping/cache_seqlens）与 advance_verify（按设备 starts 写 verify 的 [bs,m] 元数据 + cu_seqlens_k 前缀和）。",
        "pitfalls": [
          "advances 必须每行独立（投机时 1+j 逐行不同）",
          "跨页时必须读新页；cu_seqlens_k 必须是前缀和而非每行独立值"
        ]
      },
      {
        "path": "src/spec/dspark/paged_cache.py",
        "label": "页式草稿 KV",
        "summary": "页池 + 页表替代按行预留：容量 O(实际 token)，页号 int64 高位留 tier/device。读路径一 gather 成稠密走现有 SDPA（vendored attention 零改动）；读路径二走 flash_attn_with_kvcache(block_table=)。",
        "pitfalls": [
          "kv_len 是批内共享标量（max(lens)+seg_max+block），分配必须按 seg_max 否则短行读不到共享长度",
          "crop 必须退还尾部整页，只做逻辑缩短会让页数按 m 增长（1.33x 浪费照旧）",
          "页表写错会读到别的序列的数据且不报错；未参与本步的行绝不能被推进",
          "读路径二要求页大小为 256 的倍数（本仓 config 同样硬校验），且尚未在 GPU 验证"
        ]
      }
    ]
